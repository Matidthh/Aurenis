# Environment Variables for Production - Aurenis
# Copy this file to .env.production and fill in the actual values

# Database (PostgreSQL - Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.pooler.supabase.com/neondb?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.supabase.com/neondb?schema=public"

# Read Replicas (comma-separated URLs)
READ_REPLICA_URLS="postgresql://user:password@replica1.example.com/neondb,postgresql://user:password@replica2.example.com/neondb"
REPLICA_REGIONS="us-east,us-west"

# Redis (Caching & Rate Limiting)
REDIS_URL="redis://user:password@redis-host:6379"

# Auth & Security
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS_LONG"
SESSION_COOKIE_NAME="aurenis_session"

# App Configuration
NEXT_PUBLIC_APP_NAME="Aurenis"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# OpenTelemetry & Monitoring
OTEL_SERVICE_NAME="aurenis"
OTEL_SERVICE_VERSION="1.0.0"
OTEL_JAEGER_ENDPOINT="http://jaeger:14268/api/traces"
OTEL_PROMETHEUS_PORT="9464"

# Sentry (Error Tracking)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Email Service (Optional - for notifications)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# File Storage (Optional - for uploads)
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# Logging
LOG_LEVEL="info"

# Enterprise Features
ENABLE_ARCHIVING="true"
ARCHIVE_RETENTION_DAYS="365"
ENABLE_WEBHOOKS="true"
TENANT_RATE_LIMIT_ENABLED="true"
ENABLE_PARTITIONING="true"
ENABLE_READ_REPLICAS="true"