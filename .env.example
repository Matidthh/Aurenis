ENABLE_PARTITIONING=
ENABLE_READ_REPLICAS=
ENABLE_WEBHOOKS=
JWT_SECRET=
LOG_LEVEL=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=
OTEL_JAEGER_ENDPOINT=
OTEL_PROMETHEUS_PORT=
OTEL_SERVICE_NAME=
