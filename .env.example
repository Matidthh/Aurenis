# Environment variables for Aurenis

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurenis?schema=public"

# Auth & Security
# Obligatorio. Mínimo 32 caracteres. Sin este valor la app no firma ni verifica JWT.
# Genera un secreto aleatorio (por ejemplo: openssl rand -base64 48) y no lo subas al repositorio.
JWT_SECRET=
SESSION_COOKIE_NAME="aurenis_session"

# App
NEXT_PUBLIC_APP_NAME="Aurenis"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ARCHIVE_RETENTION_DAYS=
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_S3_BUCKET=
AWS_SECRET_ACCESS_KEY=
