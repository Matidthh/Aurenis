# Environment variables for Aurenis

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurenis?schema=public"

# Auth & Security
JWT_SECRET="aurenis-super-secret-key-change-this-in-production-min-32-chars-long"
SESSION_COOKIE_NAME="aurenis_session"

# App
NEXT_PUBLIC_APP_NAME="Aurenis"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
