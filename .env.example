# Base de datos (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/aurenis_db?schema=public

# Secreto criptográfico para firma y verificación JWT (HS256)
# REQUISITO OBLIGATORIO: Mínimo 32 caracteres (256 bits) de alta entropía.
# Generación recomendada: openssl rand -hex 32  o  openssl rand -base64 32
JWT_SECRET=

# Clave de cifrado simétrico a nivel de aplicación (AES-256-GCM)
# Utilizada para cifrar campos sensibles (RUT, observaciones de salud, notas confidenciales NNA).
# REQUISITO OBLIGATORIO: Mínimo 32 caracteres (256 bits).
# Generación recomendada: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Configuración de Aplicación y URLs Base
NEXT_PUBLIC_APP_NAME=Aurenis
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=aurenis_session

# URL del Frontend / Cliente Externo (para políticas de seguridad CORS)
# Permite peticiones de origen cruzado autorizadas desde la URL configurada.
FRONTEND_URL=http://localhost:3000

# Enlace de Agendamiento Directo de Demostración Comercial (Cal.com, Calendly o URL personalizada)
# Si no está definido o está vacío, el sistema utiliza el fallback de correo institucional (contacto@aurenis.cl).
# Ejemplo: https://cal.com/aurenis/demo
NEXT_PUBLIC_BOOKING_URL=

